{
  "name": "client-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "files:to-r2": "node --env-file=.env.local scripts/copy-files-to-r2.mjs",
    "claude:check": "node --env-file=.env.local scripts/claude-check.mjs",
    "claude:check:prod": "node --env-file=.env.production.local scripts/claude-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.4",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
