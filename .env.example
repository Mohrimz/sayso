# --- Supabase -----------------------------------------------------------------
# Local: run `npx supabase start` and copy the values it prints.
# Cloud: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for invites, magic links and email delivery. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sayso

# --- Email ------------------------------------------------------------------------
# Set ONE email service. With none set (development), emails are printed to
# the server console and sign-in links are shown on screen instead.
#
# Option 0: Gmail (no domain needed). Turn on 2-Step Verification, create an
# app password at myaccount.google.com/apppasswords. Up to ~500 emails/day.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# Option A: Cloudflare Email Service (domain on Cloudflare + Workers Paid plan).
# API token needs permission to send email for your account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
#
# Option B: Resend (resend.com).
RESEND_API_KEY=
#
# Sender: must be an address on a domain verified with your email service.
EMAIL_FROM="Sayso <hello@example.com>"

# --- Claude (Anthropic API) ---------------------------------------------------
# Server only. Create a key in the Claude Console: platform.claude.com > API keys.
# Leave empty to switch AI features off. Test it with `npm run claude:check`.
ANTHROPIC_API_KEY=

# Instagram results on published posts, through a Make.com scenario (lib/post-results.ts).
# MAKE_API_TOKEN needs the scenarios:run scope. Keep it secret.
MAKE_API_TOKEN=
MAKE_ZONE=eu1.make.com
MAKE_RESULTS_SCENARIO_ID=
# "Publish now" on approved posts: the Make scenario that posts to Instagram and Facebook.
# Instagram and Facebook download the files, so storage must be public (it won't work against a local Supabase).
MAKE_PUBLISH_SCENARIO_ID=
# Accounts admins can link to a client: "<instagram id>:<label>,<instagram id>:<label>"
INSTAGRAM_ACCOUNTS=
# Facebook Pages admins can link to a client: "<page id>:<label>,<page id>:<label>"
FACEBOOK_PAGES=

# Files (post media, Library, chat attachments, profile pictures) go to Cloudflare R2
# when all four are set; otherwise Supabase Storage is used. Create an R2 bucket and an
# API token with Object Read & Write on it, and add a CORS rule allowing PUT/GET from the
# site. Copy existing files over with scripts/copy-files-to-r2.mjs. Keep the secret secret.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: keep local development files apart in the same bucket, e.g. "dev/".
R2_KEY_PREFIX=
